<Window x:Class="NewsDesk.App.Views.RenameMediaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename picture"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0C1830"
        Foreground="#F2F6FC"
        ShowInTaskbar="False">
    <Border Padding="20" BorderBrush="#1B2B47" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="RENAME PICTURE" FontSize="15" FontWeight="Bold" Foreground="#F2F6FC"/>
            <TextBlock Text="This changes the name shown in the Admin Photos library. The original file is not renamed."
                       Margin="0,8,0,14" TextWrapping="Wrap" Foreground="#C9D4E4"/>
            <TextBox x:Name="NameBox" MinWidth="420" Padding="8,6" MaxLength="200"
                     KeyDown="NameBox_KeyDown"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="CANCEL" IsCancel="True" Padding="14,7" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="SAVE" IsDefault="True" Padding="14,7" Background="#E8112D" Foreground="White"
                        BorderThickness="0" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
