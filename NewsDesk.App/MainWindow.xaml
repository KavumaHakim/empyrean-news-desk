<Window x:Class="NewsDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:NewsDesk.Core.Models;assembly=NewsDesk.Core"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:conv="clr-namespace:NewsDesk.App.Converters"
        Title="EMPYREAN NEWS — Studio"
        Height="810" Width="1440"
        MinHeight="600" MinWidth="1000"
        Background="#04070D"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- ================================================================
             NEWS DESK OPERATOR DESIGN SYSTEM
             Deep navy / black control room with restrained red accent,
             coral-to-blue gradient signature, and violet supporting tones.
             ================================================================ -->
        <SolidColorBrush x:Key="InkDeep" Color="#04070D"/>
        <SolidColorBrush x:Key="InkBase" Color="#081020"/>
        <SolidColorBrush x:Key="Panel" Color="#0C1830"/>
        <SolidColorBrush x:Key="PanelRaised" Color="#122140"/>
        <SolidColorBrush x:Key="BorderLine" Color="#1B2B47"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#142240"/>
        <SolidColorBrush x:Key="AccentRed" Color="#E8112D"/>
        <SolidColorBrush x:Key="AccentRedHover" Color="#FF2745"/>
        <SolidColorBrush x:Key="AccentCoral" Color="#FF7A63"/>
        <SolidColorBrush x:Key="AccentAzure" Color="#2E7DE1"/>
        <SolidColorBrush x:Key="AccentViolet" Color="#8A63D2"/>
        <SolidColorBrush x:Key="TextHi" Color="#F2F6FC"/>
        <SolidColorBrush x:Key="TextMid" Color="#C9D4E4"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8CA0BC"/>
        <SolidColorBrush x:Key="TextDim" Color="#5E7191"/>

        <LinearGradientBrush x:Key="GradHeadline" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E8112D" Offset="0"/>
            <GradientStop Color="#FF7A63" Offset="0.35"/>
            <GradientStop Color="#2E7DE1" Offset="0.8"/>
            <GradientStop Color="#1B4E96" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GradPurple" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4A2F73" Offset="0"/>
            <GradientStop Color="#8A63D2" Offset="1"/>
        </LinearGradientBrush>

        <!-- Typography -->
        <FontFamily x:Key="FontUi">Segoe UI Variable Text, Segoe UI, Inter, Helvetica Neue, Arial</FontFamily>
        <FontFamily x:Key="FontHead">Segoe UI Variable Display, Segoe UI, Inter, Helvetica Neue, Arial</FontFamily>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        </Style>

        <!-- Section header: gradient rail + label -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontHead}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
        </Style>

        <Style x:Key="MicroLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentRedHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelRaised}"/>
            <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A3153"/>
                                <Setter Property="BorderBrush" Value="#2E4B77"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Azure action (secondary primary, e.g. LAUNCH PROJECTOR) -->
        <Style x:Key="AzureButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentAzure}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4A93F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InkBase}"/>
            <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentCoral}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentAzure}"/>
        </Style>

        <!-- Dark ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InkBase}"/>
            <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLine}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
            <!-- Fully dark template: the stock Windows chrome ignores Background and
                 left light-on-light text in the selection box. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" Background="{StaticResource InkBase}" BorderBrush="{StaticResource BorderLine}" BorderThickness="1" CornerRadius="2">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Data="M0,0 L4,4 L8,0 Z" Fill="{StaticResource TextMuted}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2E4B77"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource InkBase}" BorderBrush="{StaticResource BorderLine}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
                        <Setter Property="Background" Value="{StaticResource InkBase}"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{StaticResource PanelRaised}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Dark Slider -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentCoral}"/>
        </Style>

        <!-- DataGrid (structured newsroom table) -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#0A1428"/>
            <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#12203A"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0A1326"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1B4E96"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#101F3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Panel (control-room module: navy surface, hairline border) -->
        <Style x:Key="ModulePanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- TabItem: editorial underline accent -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border 
                                x:Name="TabChrome"
                                Background="Transparent"
                                BorderThickness="0" 
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="AccentBar" Height="2.5" VerticalAlignment="Bottom" Margin="14,0" CornerRadius="2" Opacity="0" Background="{StaticResource GradHeadline}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================================
             STUDIO LAYOUT (OBS-style): monitors on top, docks below
             ================================================================ -->
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <conv:ThumbnailConverter x:Key="Thumb"/>

        <!-- Dock: titled panel like OBS's Sources / Audio Mixer / Controls -->
        <Style x:Key="Dock" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style x:Key="DockTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontHead}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DockHeader" TargetType="Border">
            <Setter Property="Background" Value="#0A1428"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="3,3,0,0"/>
        </Style>

        <!-- Compact button for dense docks -->
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SmallPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SmallAzure" TargetType="Button" BasedOn="{StaticResource AzureButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Layer on/off switch: Tag carries the live state (True = on air) -->
        <Style x:Key="LayerToggle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Background" Value="{StaticResource InkBase}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLine}"/>
            <Setter Property="Content" Value="OFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                    <Setter Property="Content" Value="ON"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="{StaticResource AccentRed}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentRedHover}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#2E4B77"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tiny chip shown on the program monitor for each live layer -->
        <Style x:Key="MonitorChip" TargetType="Border">
            <Setter Property="Background" Value="#D9C8102E"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MicroLabel}">
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform"
             StretchDirection="DownOnly"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
      <Grid Width="1440" Height="810">
        <Grid.RowDefinitions>
            <!-- Top bar: identity, projector output, on-air status -->
            <RowDefinition Height="46"/>
            <!-- Studio mode: Preview | Take | Program -->
            <RowDefinition Height="*"/>
            <!-- Docks: Sources | Layers & Mixer | Editor | Controls -->
            <RowDefinition Height="392"/>
            <!-- Status bar -->
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- 1. TOP BAR                                                     -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="#020F1E" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentRed}" CornerRadius="3,0,0,3" Padding="8,3">
                        <TextBlock Text="E" FontFamily="{StaticResource FontHead}" FontWeight="ExtraBold" FontSize="15" Foreground="White"/>
                    </Border>
                    <Border Background="#101C33" CornerRadius="0,3,3,0" Padding="10,3" BorderBrush="{StaticResource BorderLine}" BorderThickness="0,1,1,1">
                        <TextBlock Text="EMPYREAN NEWS" FontFamily="{StaticResource FontHead}" FontWeight="Bold" FontSize="15" Foreground="White"/>
                    </Border>
                    <TextBlock Text="STUDIO" FontFamily="{StaticResource FontUi}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentCoral}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Projector output -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="OUTPUT" Style="{StaticResource MicroLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding ConnectedDisplays}"
                              SelectedItem="{Binding SelectedDisplay}"
                              DisplayMemberPath="Description"
                              Width="250" Margin="0,0,6,0"/>
                    <Button Content="⟳" Command="{Binding RefreshDisplaysCommand}" Style="{StaticResource SmallButton}" ToolTip="Refresh detected monitors" Margin="0,0,10,0"/>
                    <Button Command="{Binding TogglePopoutCommand}" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                <Setter Property="Content" Value="⧉ TEST RUN"/>
                                <Setter Property="ToolTip" Value="Pop out the real projector output in a window on this screen. Rehearse in it before the projector; once the projector is open it becomes a muted mirror."/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPopoutOpen}" Value="True">
                                        <Setter Property="Content" Value="✕ CLOSE TEST RUN"/>
                                        <Setter Property="ToolTip" Value="Close the pop-out output window"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="LAUNCH PROJECTOR" Command="{Binding LaunchBroadcastCommand}" Style="{StaticResource SmallAzure}" Margin="0,0,6,0"/>
                    <Button Content="CLOSE OUTPUT" Command="{Binding CloseBroadcastCommand}" Style="{StaticResource SmallButton}"/>
                </StackPanel>

                <!-- On-air status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PlaybackTimeText}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentAzure}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border CornerRadius="999" Padding="12,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1A1403"/>
                                <Setter Property="BorderBrush" Value="#8A6A14"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveOnAir}" Value="True">
                                        <Setter Property="Background" Value="#3A050C"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#D9A81E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiveOnAir}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentRed}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontFamily="{StaticResource FontUi}" FontWeight="Bold" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="STANDBY"/>
                                        <Setter Property="Foreground" Value="#E3B93E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiveOnAir}" Value="True">
                                                <Setter Property="Text" Value="ON AIR"/>
                                                <Setter Property="Foreground" Value="#FF6B6B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- 2. STUDIO MODE: PREVIEW | TAKE | PROGRAM                       -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1" Margin="10,8,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PREVIEW -->
            <Border Grid.Column="0" Style="{StaticResource Dock}" BorderBrush="#1B4E96">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource DockHeader}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource AccentAzure}" CornerRadius="2" Padding="6,1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="PREVIEW" Style="{StaticResource ChipText}" FontSize="11"/>
                                </Border>
                                <TextBlock VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextHi}" TextTrimming="CharacterEllipsis" MaxWidth="440">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding PreviewMedia.Title}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PreviewMedia}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="{Binding PreviewGraphic.Title, FallbackValue='Nothing cued', TargetNullValue='Nothing cued'}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding PreviewMedia.KindLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MicroLabel}" Foreground="{StaticResource AccentAzure}"/>
                        </Grid>
                    </Border>

                    <!-- Private operator-side preview; never touches the projector -->
                    <Grid Grid.Row="1" Background="#02050A" ClipToBounds="True">
                        <TextBlock Text="Double-click a source below to cue it here" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="13"/>
                        <MediaElement x:Name="PreviewVideoMonitor"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      ScrubbingEnabled="True"
                                      Volume="0"
                                      Stretch="Uniform"
                                      MediaOpened="PreviewVideoMonitor_MediaOpened"
                                      MediaEnded="PreviewVideoMonitor_MediaEnded"
                                      MediaFailed="PreviewVideoMonitor_MediaFailed"/>
                        <Image x:Name="PreviewImageMonitor" Stretch="Uniform" Visibility="Collapsed"/>

                        <!-- Graphic slide placeholder -->
                        <Border Background="#EEF0F4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewGraphic}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center" Margin="40,0">
                                <Border Background="{StaticResource AccentRed}" HorizontalAlignment="Left" Padding="8,2" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding PreviewGraphic.Category}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                </Border>
                                <TextBlock Text="{Binding PreviewGraphic.Title}" Foreground="#0C1424" FontFamily="{StaticResource FontHead}" FontWeight="Black" FontSize="26" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding PreviewGraphic.Subtitle}" Foreground="#1C2433" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Person caption preview -->
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,22" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewMedia.CaptionName, FallbackValue=''}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Background="White" BorderBrush="{StaticResource AccentRed}" BorderThickness="5,0,0,0" Padding="10,3">
                                <TextBlock Text="{Binding PreviewMedia.CaptionName}" Foreground="#0C1424" FontWeight="Bold" FontSize="15"/>
                            </Border>
                            <Border Background="{StaticResource AccentRed}" HorizontalAlignment="Left" Padding="10,2">
                                <TextBlock Text="{Binding PreviewMedia.CaptionTitle}" Foreground="White" FontWeight="SemiBold" FontSize="11.5"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Preview transport (operator only) -->
                    <Grid Grid.Row="2" Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="PLAY" Click="PreviewPlayPause_Click" Style="{StaticResource SmallButton}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="↺" Click="PreviewReplay_Click" Style="{StaticResource SmallButton}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Slider x:Name="PreviewTimelineSlider" Grid.Column="2" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="PreviewTimeDisplay" Grid.Column="3" Text="00:00 / 00:00" Foreground="{StaticResource TextMid}" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- TAKE column (studio-mode transition) -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="TRANSITION" Style="{StaticResource MicroLabel}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding AvailableTransitions}"
                          SelectedItem="{Binding PreviewTransition, Mode=TwoWay}"
                          Margin="0,0,0,4"/>
                <TextBlock Text="500 ms · Cut 0 ms" Style="{StaticResource MicroLabel}" FontSize="10.5" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <Button Command="{Binding TakeLiveCommand}" Style="{StaticResource PrimaryButton}" Height="84" Padding="6" ToolTip="Send Preview to Program with the chosen transition">
                    <StackPanel>
                        <TextBlock Text="TAKE ▶" Foreground="White" FontFamily="{StaticResource FontHead}" FontWeight="ExtraBold" FontSize="20" HorizontalAlignment="Center"/>
                        <TextBlock Text="F5" Foreground="#FFD0D6" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Content="STANDBY  F6" Command="{Binding ToggleStandbyCommand}" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"/>
                <TextBlock Text="Esc = emergency standby" Style="{StaticResource MicroLabel}" FontSize="10.5" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- PROGRAM -->
            <Border Grid.Column="2">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Dock}">
                        <Setter Property="BorderBrush" Value="#5C1220"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLiveOnAir}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource DockHeader}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource AccentRed}" CornerRadius="2" Padding="6,1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="PROGRAM" Style="{StaticResource ChipText}" FontSize="11"/>
                                </Border>
                                <TextBlock VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextHi}" TextTrimming="CharacterEllipsis" MaxWidth="400">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding OnAirMedia.Title}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OnAirMedia}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="{Binding OnAirGraphic.Title, FallbackValue='Nothing on air', TargetNullValue='Nothing on air'}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding ActiveTransition, StringFormat='via {0}'}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MicroLabel}" Foreground="{StaticResource AccentCoral}"/>
                        </Grid>
                    </Border>

                    <!-- Dashboard mirror of the projector; the canvas stays authoritative -->
                    <Grid Grid.Row="1" Background="#02050A" ClipToBounds="True">
                        <MediaElement x:Name="ProgramVideoMonitor"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      Volume="0"
                                      Stretch="Uniform"
                                      MediaOpened="ProgramVideoMonitor_MediaOpened"
                                      MediaFailed="ProgramVideoMonitor_MediaFailed"/>
                        <Image x:Name="ProgramImageMonitor" Stretch="Uniform" Visibility="Collapsed"/>

                        <Border Background="#EEF0F4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OnAirGraphic}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center" Margin="40,0">
                                <Border Background="{StaticResource AccentRed}" HorizontalAlignment="Left" Padding="8,2" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding OnAirGraphic.Category}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                </Border>
                                <TextBlock Text="{Binding OnAirGraphic.Title}" Foreground="#0C1424" FontFamily="{StaticResource FontHead}" FontWeight="Black" FontSize="26" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Person caption on air -->
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,22" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OnAirMedia.CaptionName, FallbackValue=''}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSceneCaptionVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Background="White" BorderBrush="{StaticResource AccentRed}" BorderThickness="5,0,0,0" Padding="10,3">
                                <TextBlock Text="{Binding OnAirMedia.CaptionName}" Foreground="#0C1424" FontWeight="Bold" FontSize="15"/>
                            </Border>
                            <Border Background="{StaticResource AccentRed}" HorizontalAlignment="Left" Padding="10,2">
                                <TextBlock Text="{Binding OnAirMedia.CaptionTitle}" Foreground="White" FontWeight="SemiBold" FontSize="11.5"/>
                            </Border>
                        </StackPanel>

                        <!-- Standby slate indicator -->
                        <Border Background="#E6081020" Visibility="{Binding IsStandbyActive, Converter={StaticResource BoolVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="STANDBY SLATE ON AIR" Foreground="#E3B93E" FontFamily="{StaticResource FontHead}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="Cue a source in Preview, then TAKE (F5)" Foreground="{StaticResource TextMuted}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Live layer chips -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" IsHitTestVisible="False">
                            <Border Style="{StaticResource MonitorChip}" Visibility="{Binding IsLowerThirdLive, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="LOWER THIRD" Style="{StaticResource ChipText}"/>
                            </Border>
                            <Border Style="{StaticResource MonitorChip}" Visibility="{Binding IsVoiceOverActive, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="VOICE-OVER" Style="{StaticResource ChipText}"/>
                            </Border>
                            <Border Style="{StaticResource MonitorChip}" Visibility="{Binding AreSpeakersLive, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="SPEAKERS" Style="{StaticResource ChipText}"/>
                            </Border>
                            <Border Style="{StaticResource MonitorChip}" Background="#D92E7DE1" Visibility="{Binding IsTickerVisible, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="TICKER" Style="{StaticResource ChipText}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Program transport (controls the projector) -->
                    <Grid Grid.Row="2" Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Button Content="▶" Command="{Binding PlayCommand}" Style="{StaticResource SmallButton}" Margin="0,0,3,0" ToolTip="Play (Space)"/>
                            <Button Content="❚❚" Command="{Binding PauseCommand}" Style="{StaticResource SmallButton}" Margin="0,0,3,0" ToolTip="Pause (Space)"/>
                            <Button Content="■" Command="{Binding StopCommand}" Style="{StaticResource SmallButton}" Margin="0,0,3,0" ToolTip="Stop"/>
                            <Button Content="↺" Command="{Binding ReplayCommand}" Style="{StaticResource SmallButton}" ToolTip="Replay from start" Margin="0,0,6,0"/>
                            <Button Content="🎙 HOLD SOUND" Command="{Binding HoldProgramSoundCommand}" Style="{StaticResource SmallButton}"
                                    ToolTip="Keep this video's sound running as a voice-over, then take pictures or other video live over it"/>
                        </StackPanel>
                        <Slider x:Name="TimelineSlider" Grid.Column="1" Minimum="0"
                                Maximum="{Binding PlaybackDuration}"
                                Value="{Binding PlaybackCurrentTime, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- 3. DOCKS                                                       -->
        <!-- ============================================================== -->
        <Grid Grid.Row="2" Margin="10,0,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="210"/>
            </Grid.ColumnDefinitions>

            <!-- ======================= SOURCES ======================= -->
            <Border Grid.Column="0" Style="{StaticResource Dock}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource DockHeader}">
                        <Grid>
                            <TextBlock Text="SOURCES" Style="{StaticResource DockTitle}"/>
                            <TextBlock Text="double-click = cue to Preview" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MicroLabel}" FontSize="10.5" Foreground="{StaticResource TextDim}"/>
                        </Grid>
                    </Border>

                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                <Setter Property="Padding" Value="12,6"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                        </TabControl.Resources>

                        <!-- MEDIA: videos and pictures -->
                        <TabItem Header="MEDIA">
                            <Grid Margin="8,6,8,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="112"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" Margin="0,0,4,0" ToolTip="Search titles"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding MediaKinds}" SelectedItem="{Binding KindFilter}" Padding="6,3" Margin="0,0,4,0"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding CategoryFilter}" Padding="6,3"/>
                                </Grid>

                                <DataGrid x:Name="MediaGrid" Grid.Row="1" ItemsSource="{Binding FilteredMediaLibrary}"
                                          SelectedItem="{Binding SelectedMedia}"
                                          IsReadOnly="True" SelectionMode="Single" RowHeight="24"
                                          MouseDoubleClick="MediaGrid_MouseDoubleClick">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <!-- The menu lives outside the visual tree: hand it the view model via the row's Tag -->
                                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            <Setter Property="ContextMenu">
                                                <Setter.Value>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="Rename picture…"
                                                                  Visibility="{Binding IsImage, Converter={StaticResource BoolVis}}"
                                                                  Command="{Binding PlacementTarget.Tag.RenameMediaCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}"
                                                                  ToolTip="Change the picture name shown in the Admin Photos library"/>
                                                    </ContextMenu>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="TYPE" Binding="{Binding KindLabel}" Width="62" Foreground="{StaticResource TextMuted}"/>
                                        <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="*" Foreground="{StaticResource TextHi}"/>
                                        <DataGridTextColumn Header="CAPTION" Binding="{Binding CaptionName}" Width="90" Foreground="{StaticResource AccentCoral}"/>
                                        <DataGridTextColumn Header="EFFECT" Binding="{Binding AssignedTransition}" Width="74"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Selected source details: effect + person caption -->
                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Effect" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="ComboSelectedTransition"
                                                  ItemsSource="{Binding AvailableTransitions}"
                                                  SelectedItem="{Binding SelectedMedia.AssignedTransition, Mode=TwoWay}"
                                                  SelectionChanged="OnTransitionSelectionChanged"
                                                  Padding="6,3"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Caption name" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SelectedMedia.CaptionName, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Designation" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SelectedMedia.CaptionTitle, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                    </StackPanel>
                                    <Button Grid.Column="6" Content="SAVE" Command="{Binding SaveMediaDetailsCommand}" Style="{StaticResource SmallButton}" VerticalAlignment="Bottom" ToolTip="Save the caption (re-cues Preview if this item is cued)"/>
                                </Grid>

                                <Grid Grid.Row="3" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="CUE TO PREVIEW" Command="{Binding SelectForPreviewCommand}" Style="{StaticResource SmallAzure}" Margin="0,0,4,0"/>
                                        <Button Content="+ RUNDOWN" Command="{Binding AddToRundownCommand}" Style="{StaticResource SmallButton}" Margin="0,0,4,0"/>
                                        <Button Content="IMPORT…" Command="{Binding ImportVideoCommand}" Style="{StaticResource SmallPrimary}" ToolTip="Import videos or pictures"/>
                                    </StackPanel>
                                    <Button Content="REMOVE" Command="{Binding DeleteMediaCommand}" Style="{StaticResource SmallButton}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- RUNDOWN: the story list (same stories as the STORIES editor) -->
                        <TabItem Header="RUNDOWN">
                            <Grid Margin="8,6,8,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Stories in running order. TAKE puts the media up with its lower third; edit in STORIES." Style="{StaticResource MicroLabel}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <DataGrid x:Name="RundownGrid" Grid.Row="1" ItemsSource="{Binding HeadlineSequence}"
                                          SelectedItem="{Binding SelectedHeadlineItem}"
                                          IsReadOnly="True" RowHeight="24"
                                          MouseDoubleClick="RundownGrid_MouseDoubleClick">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnAir}" Value="True">
                                                    <Setter Property="Background" Value="#3A0A14"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="28"/>
                                        <DataGridTextColumn Header="STORY" Binding="{Binding ListTitle}" Width="*" Foreground="{StaticResource TextHi}"/>
                                        <DataGridTextColumn Header="MEDIA" Binding="{Binding MediaItem.KindLabel, FallbackValue=SLIDE, TargetNullValue=SLIDE}" Width="58" Foreground="{StaticResource TextMuted}"/>
                                        <DataGridTextColumn Header="+" Binding="{Binding ExtraMedia.Count}" Width="26" Foreground="{StaticResource AccentCoral}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                                    <Button Content="▲" Command="{Binding MoveHeadlineUpCommand}" Style="{StaticResource SmallButton}" Margin="0,0,3,0" ToolTip="Move up"/>
                                    <Button Content="▼" Command="{Binding MoveHeadlineDownCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" ToolTip="Move down"/>
                                    <Button Content="CUE" Command="{Binding CueStoryCommand}" Style="{StaticResource SmallAzure}" Margin="0,0,4,0" ToolTip="Cue the story's media in Preview (its lower third follows on TAKE)"/>
                                    <Button Content="TAKE LIVE NOW" Command="{Binding TakeLiveRundownCommand}" Style="{StaticResource SmallPrimary}" Margin="0,0,4,0"/>
                                    <Button Content="EDIT" Command="{Binding OpenEditorCommand}" CommandParameter="1" Style="{StaticResource SmallButton}" ToolTip="Open the STORIES editor"/>
                                </WrapPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- ================== LAYERS + AUDIO MIXER ================== -->
            <Border Grid.Column="2" Style="{StaticResource Dock}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource DockHeader}">
                        <Grid>
                            <TextBlock Text="ON-AIR LAYERS" Style="{StaticResource DockTitle}"/>
                            <TextBlock Text="⚙ = edit" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MicroLabel}" FontSize="10.5" Foreground="{StaticResource TextDim}"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="8,6,8,4">
                        <StackPanel.Resources>
                            <Style x:Key="LayerName" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12.5"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="8,0,0,0"/>
                            </Style>
                            <Style x:Key="EditButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                <Setter Property="Content" Value="⚙"/>
                                <Setter Property="Padding" Value="6,1"/>
                                <Setter Property="Command" Value="{Binding OpenEditorCommand}"/>
                            </Style>
                        </StackPanel.Resources>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource LayerToggle}" Tag="{Binding IsLowerThirdLive}" Command="{Binding ToggleLowerThirdCommand}" ToolTip="Take the Graphics editor's lower third live / clear it"/>
                            <TextBlock Grid.Column="1" Text="Lower third" Style="{StaticResource LayerName}"/>
                            <Button Grid.Column="2" Style="{StaticResource EditButton}" CommandParameter="0"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource LayerToggle}" Tag="{Binding IsHeadlinesPlaying}" Command="{Binding ToggleHeadlinesCommand}" ToolTip="Play the headlines segment / stop it"/>
                            <TextBlock Grid.Column="1" Text="Headlines segment" Style="{StaticResource LayerName}"/>
                            <Button Grid.Column="2" Style="{StaticResource EditButton}" CommandParameter="1"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource LayerToggle}" Tag="{Binding IsHeadlinesBoardLive}" Command="{Binding ToggleHeadlinesBoardCommand}" ToolTip="Every headline on screen at once (F9)"/>
                            <TextBlock Grid.Column="1" Text="All headlines  (F9)" Style="{StaticResource LayerName}"/>
                            <Button Grid.Column="2" Style="{StaticResource EditButton}" CommandParameter="1"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource LayerToggle}" Tag="{Binding IsTickerVisible}" Command="{Binding ToggleTickerVisibleCommand}"/>
                            <TextBlock Grid.Column="1" Text="News ticker" Style="{StaticResource LayerName}"/>
                            <Button Grid.Column="2" Style="{StaticResource EditButton}" CommandParameter="2"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource LayerToggle}" Tag="{Binding IsVoiceOverActive}" Command="{Binding ToggleVoiceOverCommand}"/>
                            <TextBlock Grid.Column="1" Text="Voice-over" Style="{StaticResource LayerName}"/>
                            <Button Grid.Column="2" Style="{StaticResource EditButton}" CommandParameter="3"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource LayerToggle}" Tag="{Binding AreSpeakersLive}" Command="{Binding ToggleSpeakersCommand}"/>
                            <TextBlock Grid.Column="1" Text="Speaker windows (2)" Style="{StaticResource LayerName}"/>
                            <Button Grid.Column="2" Style="{StaticResource EditButton}" CommandParameter="4"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource LayerToggle}" Tag="{Binding IsSceneCaptionVisible}" Command="{Binding ToggleSceneCaptionCommand}" ToolTip="Show/hide person name captions on pictures and videos"/>
                            <TextBlock Grid.Column="1" Text="Name captions" Style="{StaticResource LayerName}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource LayerToggle}" Tag="{Binding IsLiveIndicatorVisible}" Command="{Binding ToggleLiveIndicatorCommand}"/>
                            <TextBlock Grid.Column="1" Text="LIVE badge" Style="{StaticResource LayerName}"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="2" Style="{StaticResource DockHeader}" CornerRadius="0" BorderThickness="0,1,0,1">
                        <TextBlock Text="AUDIO MIXER" Style="{StaticResource DockTitle}"/>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="8,6,8,0">
                        <StackPanel.Resources>
                            <Style x:Key="MixLabel" TargetType="TextBlock" BasedOn="{StaticResource MicroLabel}">
                                <Setter Property="Width" Value="70"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="MixValue" TargetType="TextBlock">
                                <Setter Property="Width" Value="36"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </StackPanel.Resources>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Program" Style="{StaticResource MixLabel}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgramVolume, StringFormat='{}{0:P0}'}" Style="{StaticResource MixValue}"/>
                            <Slider Minimum="0" Maximum="1" Value="{Binding ProgramVolume}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Voice-over" Style="{StaticResource MixLabel}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VoiceOverVolume, StringFormat='{}{0:P0}'}" Style="{StaticResource MixValue}"/>
                            <Slider Minimum="0" Maximum="1" Value="{Binding VoiceOverVolume}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4" ToolTip="Program level while a voice-over or a speaker clip with sound is on air">
                            <TextBlock DockPanel.Dock="Left" Text="Duck to" Style="{StaticResource MixLabel}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VoiceOverDuckLevel, StringFormat='{}{0:P0}'}" Style="{StaticResource MixValue}"/>
                            <Slider Minimum="0" Maximum="1" Value="{Binding VoiceOverDuckLevel}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Intro" Style="{StaticResource MixLabel}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding IntroVolume, StringFormat='{}{0:P0}'}" Style="{StaticResource MixValue}"/>
                            <Slider Minimum="0" Maximum="1" Value="{Binding IntroVolume}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================= EDITOR ======================= -->
            <Border Grid.Column="4" Style="{StaticResource Dock}">
                <TabControl Background="Transparent" BorderThickness="0" Padding="0" SelectedIndex="{Binding EditorTabIndex, Mode=TwoWay}">
                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                            <Setter Property="Padding" Value="7,6"/>
                            <Setter Property="FontSize" Value="11.5"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- 0. GRAPHICS & LOWER THIRDS -->
                    <TabItem Header="GRAPHICS">
                        <Grid Margin="10,8,10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Headline" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditingHeadline.Title, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" Margin="0,0,0,6"/>
                                    <TextBlock Text="Summary" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditingHeadline.Subtitle, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding EditingHeadline.Category, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Location" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding EditingHeadline.Location, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Reporter / guest" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding EditingHeadline.ReporterName, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Their title" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding EditingHeadline.ReporterTitle, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="6"/><ColumnDefinition Width="90"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Template" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox SelectedItem="{Binding EditingHeadline.TemplateType}" ItemsSource="{Binding HeadlineTemplates}" Padding="6,3"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Slide palette" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox SelectedItem="{Binding EditingHeadline.BackgroundStyle}" ItemsSource="{Binding GraphicPalettes}" Padding="6,3"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="4" Content="BREAKING" IsChecked="{Binding EditingHeadline.IsBreaking}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                    </Grid>
                                    <WrapPanel>
                                        <Button Content="TAKE LOWER THIRD LIVE" Command="{Binding TakeLiveHeadlineCommand}" Style="{StaticResource SmallPrimary}" Margin="0,0,4,4"/>
                                        <Button Content="UPDATE LIVE" Command="{Binding UpdateLiveHeadlineCommand}" Style="{StaticResource SmallButton}" Margin="0,0,4,4"/>
                                        <Button Content="CLEAR" Command="{Binding ClearLiveHeadlineCommand}" Style="{StaticResource SmallButton}" Margin="0,0,10,4"/>
                                        <Button Content="CUE AS FULL SLIDE" Command="{Binding PreviewHeadlineCommand}" Style="{StaticResource SmallAzure}" Margin="0,0,4,4" ToolTip="Cue as a full-screen slide in Preview, then TAKE"/>
                                        <Button Content="SAVE DRAFT" Command="{Binding SaveHeadlineDraftCommand}" Style="{StaticResource SmallButton}" Margin="0,0,4,4"/>
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="SAVED DRAFTS" Style="{StaticResource FieldLabel}"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding HeadlineDrafts}" IsReadOnly="True" HeadersVisibility="None" RowHeight="26">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Title}" Width="*" Foreground="{StaticResource TextHi}"/>
                                        <DataGridTemplateColumn Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="LOAD" Command="{Binding DataContext.LoadHeadlineDraftCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="5,1" FontSize="10.5" Margin="0,0,2,0"/>
                                                        <Button Content="✕" Command="{Binding DataContext.DeleteHeadlineDraftCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="5,1" FontSize="10.5" ToolTip="Delete draft"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- 1. STORIES: the rundown. Each story is written once — headline + summary are
                         its lower third on air and its entry in the headlines segment. -->
                    <TabItem Header="STORIES">
                        <Grid Margin="10,8,10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="250"/>
                            </Grid.ColumnDefinitions>

                            <!-- Running order + segment playback -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DataGrid Grid.Row="0" ItemsSource="{Binding HeadlineSequence}"
                                          SelectedItem="{Binding SelectedHeadlineItem}"
                                          IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          SelectionMode="Single" RowHeight="38">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnAir}" Value="True">
                                                    <Setter Property="Background" Value="#3A0A14"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Number, Mode=OneWay}" Width="26" IsReadOnly="True"/>
                                        <DataGridCheckBoxColumn Header="HL" Binding="{Binding InHeadlines, UpdateSourceTrigger=PropertyChanged}" Width="30"/>
                                        <DataGridTemplateColumn Header="MEDIA" Width="58" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Width="50" Height="30" Background="#0A1428" BorderBrush="{StaticResource BorderLine}" BorderThickness="1" ToolTip="{Binding MediaLabel}">
                                                        <Grid>
                                                            <TextBlock Text="{Binding MediaItem.KindLabel, FallbackValue=SLIDE, TargetNullValue=SLIDE}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource Thumb}}" Stretch="UniformToFill"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="HEADLINE / SUMMARY" Width="*" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ListTitle}" Foreground="{StaticResource TextHi}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="+" Binding="{Binding ExtraMedia.Count, Mode=OneWay}" Width="24" IsReadOnly="True" Foreground="{StaticResource AccentCoral}"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                                    <Button Content="📝 TYPE ALL…" Command="{Binding EditAllHeadlinesCommand}" Style="{StaticResource SmallAzure}" Margin="0,0,4,4" ToolTip="Write or paste every headline and summary at once"/>
                                    <Button Content="+ STORY" Command="{Binding AddHeadlineItemCommand}" Style="{StaticResource SmallButton}" Margin="0,0,4,4" ToolTip="New story with the source selected in SOURCES (or a headline slide)"/>
                                    <Button Content="▲" Command="{Binding MoveHeadlineUpCommand}" Style="{StaticResource SmallButton}" Margin="0,0,2,4"/>
                                    <Button Content="▼" Command="{Binding MoveHeadlineDownCommand}" Style="{StaticResource SmallButton}" Margin="0,0,4,4"/>
                                    <Button Content="CUE" Command="{Binding CueStoryCommand}" Style="{StaticResource SmallAzure}" Margin="0,0,4,4"/>
                                    <Button Content="TAKE LIVE NOW" Command="{Binding TakeLiveRundownCommand}" Style="{StaticResource SmallPrimary}" Margin="0,0,4,4" ToolTip="Story media on air with its lower third"/>
                                    <Button Content="REMOVE" Command="{Binding RemoveHeadlineItemCommand}" Style="{StaticResource SmallButton}" Margin="0,0,0,4"/>
                                </WrapPanel>

                                <!-- Headlines segment: the stories ticked HL -->
                                <Border Grid.Row="2" Background="{StaticResource InkBase}" BorderBrush="{StaticResource BorderLine}" BorderThickness="1" Padding="6,4">
                                    <StackPanel>
                                        <WrapPanel>
                                            <TextBlock Text="HEADLINES" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Button Content="▶ PLAY" Command="{Binding PlayHeadlinesCommand}" Style="{StaticResource SmallPrimary}" Margin="0,0,3,0" ToolTip="Take every HL story live in order"/>
                                            <Button Content="◀" Command="{Binding PreviousHeadlineCommand}" Style="{StaticResource SmallButton}" Margin="0,0,2,0"/>
                                            <Button Content="▶" Command="{Binding NextHeadlineCommand}" Style="{StaticResource SmallButton}" Margin="0,0,2,0"/>
                                            <Button Content="■" Command="{Binding StopHeadlinesCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" ToolTip="Stop the segment"/>
                                            <Button Command="{Binding ToggleHeadlinesBoardCommand}" ToolTip="Every HL headline and summary on screen together">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                        <Setter Property="Content" Value="▦ SHOW ALL"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHeadlinesBoardLive}" Value="True">
                                                                <Setter Property="Content" Value="■ HIDE ALL"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </WrapPanel>
                                        <DockPanel Margin="0,4,0,0">
                                            <CheckBox DockPanel.Dock="Left" Content="Auto-advance" IsChecked="{Binding HeadlinesAutoAdvance}" FontSize="11.5" Margin="0,0,8,0"/>
                                            <TextBox DockPanel.Dock="Right" Text="{Binding HeadlinesBoardTitle, UpdateSourceTrigger=LostFocus}" Width="130" Padding="4,1" FontSize="11.5" ToolTip="Heading above SHOW ALL"/>
                                            <TextBlock Text="{Binding HeadlinesStatusText}" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- The selected story: write it once, attach its media -->
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedHeadlineItem}" Value="{x:Null}">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="Headline (lower third + headlines)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding SelectedHeadlineItem.Title, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" Margin="0,0,0,5" TextWrapping="Wrap" MaxHeight="44"/>
                                    <TextBlock Text="Summary" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding SelectedHeadlineItem.Subtitle, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" Margin="0,0,0,5" TextWrapping="Wrap" MaxHeight="44"/>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Tag" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding SelectedHeadlineItem.Category, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" ToolTip="Seconds in the headlines segment. For a video, 0 plays the whole clip.">
                                            <TextBlock Text="HL secs" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding SelectedHeadlineItem.DurationSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Location (lower third)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding SelectedHeadlineItem.Location, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" Content="BREAKING" IsChecked="{Binding SelectedHeadlineItem.IsBreaking}" VerticalAlignment="Bottom" Margin="0,0,0,4" FontSize="12"/>
                                    </Grid>
                                    <CheckBox Content="Include in the headlines" IsChecked="{Binding SelectedHeadlineItem.InHeadlines}" Margin="0,0,0,8" FontSize="12"/>

                                    <TextBlock Text="Speakers — one per line:  Name | title" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding SelectedHeadlineItem.SpeakersText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" MinHeight="44" MaxHeight="70" Padding="6,3" Margin="0,0,0,4"
                                             FontFamily="Consolas" FontSize="12" ToolTip="e.g.  Amina Okello | Head Prefect"/>
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Content="HEADLINE ONLY" Command="{Binding StoryHeadlineOnlyCommand}" Style="{StaticResource SmallButton}" Padding="6,1" FontSize="11" Margin="0,0,4,4"
                                                ToolTip="Lower third with the story headline and summary, no name"/>
                                        <ItemsControl ItemsSource="{Binding SelectedHeadlineItem.Speakers}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Name}" ToolTip="{Binding Label}"
                                                            Command="{Binding DataContext.ShowStorySpeakerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource SmallPrimary}" Padding="6,1" FontSize="11" Margin="0,0,4,4"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>

                                    <TextBlock Text="Main video / picture" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding SelectedHeadlineItem.MediaLabel}" Foreground="{StaticResource TextHi}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,3"/>
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Content="USE SELECTED SOURCE" Command="{Binding UseSelectedMediaForHeadlineCommand}" Style="{StaticResource SmallButton}" Margin="0,0,4,0" ToolTip="Use the video or picture selected in SOURCES"/>
                                        <Button Content="NONE" Command="{Binding ClearHeadlineMediaCommand}" Style="{StaticResource SmallButton}" ToolTip="Show the story as a full-screen headline slide"/>
                                    </WrapPanel>

                                    <DockPanel Margin="0,0,0,3">
                                        <Button DockPanel.Dock="Right" Content="+ ADD SELECTED" Command="{Binding AddStoryExtraMediaCommand}" Style="{StaticResource SmallButton}" Padding="6,1" FontSize="11" ToolTip="Add the source selected in SOURCES to this story"/>
                                        <TextBlock Text="More media for this story" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding SelectedHeadlineItem.ExtraMedia}" Margin="0,0,0,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource InkBase}" BorderBrush="{StaticResource BorderLine}" BorderThickness="1" Padding="6,4" Margin="0,0,0,4">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,3">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Media.KindLabel}" Foreground="{StaticResource TextDim}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Media.Title}" Foreground="{StaticResource TextHi}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                        <WrapPanel Margin="0,0,0,3">
                                                            <Button Content="CUE" Command="{Binding DataContext.CueStoryMediaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource SmallAzure}" Padding="6,1" FontSize="10.5" Margin="0,0,2,2" ToolTip="Load this shot into Preview with its lower third; TAKE (F5) puts it on air"/>
                                                            <Button Content="TAKE" Command="{Binding DataContext.TakeStoryMediaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource SmallPrimary}" Padding="6,1" FontSize="10.5" Margin="0,0,2,2" ToolTip="Put this shot on air now with its lower third"/>
                                                            <Button Content="VO" Command="{Binding DataContext.VoiceOverStoryMediaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource SmallButton}" Padding="5,1" FontSize="10.5" Margin="0,0,2,2" ToolTip="Play its sound as a voice-over under what's on air"/>
                                                            <Button Content="W1" Command="{Binding DataContext.Window1StoryMediaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource SmallButton}" Padding="5,1" FontSize="10.5" Margin="0,0,2,2" ToolTip="Show in speaker window 1"/>
                                                            <Button Content="W2" Command="{Binding DataContext.Window2StoryMediaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource SmallButton}" Padding="5,1" FontSize="10.5" Margin="0,0,2,2" ToolTip="Show in speaker window 2"/>
                                                            <Button Content="✕" Command="{Binding DataContext.RemoveStoryExtraMediaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource SmallButton}" Padding="5,1" FontSize="10.5" Margin="0,0,0,2" ToolTip="Remove from this story"/>
                                                        </WrapPanel>
                                                        <TextBlock Text="Lower third for this shot (blank = the story's)" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" Margin="0,0,0,2" FontSize="11.5" ToolTip="Headline for this shot"/>
                                                        <TextBox Text="{Binding Subtitle, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" FontSize="11" ToolTip="Summary for this shot"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="ON AIR CONTROL" Style="{StaticResource FieldLabel}" Margin="0,4,0,2"/>
                                    <CheckBox Content="Taking a story puts up its lower third" IsChecked="{Binding StoryLowerThirdAuto}" FontSize="11.5" Margin="0,0,0,3"/>
                                    <CheckBox IsChecked="{Binding StoryAutoAdvance}" FontSize="11.5" Margin="0,0,0,3"
                                              ToolTip="Off: when a video ends it stays on its last frame until you TAKE something">
                                        <TextBlock Text="When a video ends, take the next story on air by itself" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding StoryAutoCueNext}" FontSize="11.5" Margin="0,0,0,4"
                                              ToolTip="Off: Preview only changes when you cue something">
                                        <TextBlock Text="After a take, load the next story into Preview" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource AccentCoral}" TextTrimming="CharacterEllipsis"
                                               Text="{Binding OnAirStory.ListTitle, StringFormat='ON AIR: {0}', FallbackValue='No story on air', TargetNullValue='No story on air'}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- 2. TICKER -->
                    <TabItem Header="TICKER">
                        <Grid Margin="10,8,10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewTickerItemCategory, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" ToolTip="Category tag"/>
                                <TextBox Grid.Column="2" Text="{Binding NewTickerItemText, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" ToolTip="Ticker headline"/>
                                <Button Grid.Column="4" Content="ADD" Command="{Binding AddTickerItemCommand}" Style="{StaticResource SmallPrimary}"/>
                            </Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding TickerDraftItems}" IsReadOnly="False" RowHeight="24">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="ON" Binding="{Binding IsActive}" Width="40"/>
                                    <DataGridTextColumn Header="TAG" Binding="{Binding Category}" Width="90" Foreground="{StaticResource TextHi}"/>
                                    <DataGridTextColumn Header="HEADLINE" Binding="{Binding Text}" Width="*" Foreground="{StaticResource TextHi}"/>
                                    <DataGridTemplateColumn Width="34">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" Command="{Binding DataContext.DeleteTickerItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="5,1" FontSize="10.5" ToolTip="Delete"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Ribbon style -->
                            <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                                <WrapPanel.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MicroLabel}">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0,0,4,0"/>
                                    </Style>
                                </WrapPanel.Resources>
                                <CheckBox Content="Breaking red" IsChecked="{Binding DraftTickerConfig.IsBreakingStyle}" Margin="0,0,10,4" FontSize="12"/>
                                <CheckBox Content="Visible" IsChecked="{Binding DraftTickerConfig.IsVisible}" Margin="0,0,10,4" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                    <TextBlock Text="Speed"/>
                                    <Slider Minimum="40" Maximum="240" Width="70" Value="{Binding DraftTickerConfig.SpeedPixelsPerSecond}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DraftTickerConfig.SpeedPixelsPerSecond, StringFormat='{}{0:0}'}" Width="26" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                    <TextBlock Text="Height"/>
                                    <Slider Minimum="40" Maximum="90" Width="60" Value="{Binding DraftTickerConfig.RibbonHeight}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DraftTickerConfig.RibbonHeight, StringFormat='{}{0:0}'}" Width="22" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                    <TextBlock Text="Font"/>
                                    <Slider Minimum="14" Maximum="32" Width="60" Value="{Binding DraftTickerConfig.FontSize}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DraftTickerConfig.FontSize, StringFormat='{}{0:0}'}" Width="22" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                    <TextBlock Text="Tag"/>
                                    <TextBox Text="{Binding DraftTickerConfig.HeaderTag}" Width="96" Padding="4,2"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                    <TextBlock Text="Sep."/>
                                    <TextBox Text="{Binding DraftTickerConfig.Separator}" Width="30" Padding="4,2"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                    <TextBlock Text="Text"/>
                                    <TextBox Text="{Binding DraftTickerConfig.TextColor}" Width="66" Padding="4,2" FontFamily="Consolas" FontSize="11.5"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Ribbon"/>
                                    <TextBox Text="{Binding DraftTickerConfig.BackgroundColor}" Width="66" Padding="4,2" FontFamily="Consolas" FontSize="11.5"/>
                                </StackPanel>
                            </WrapPanel>

                            <Grid Grid.Row="3" Margin="0,4,0,0">
                                <Button Content="PAUSE / RESUME SCROLL" Command="{Binding ToggleTickerPauseCommand}" Style="{StaticResource SmallButton}" HorizontalAlignment="Left"/>
                                <Button Content="PUBLISH TICKER TO AIR" Command="{Binding PublishTickerCommand}" Style="{StaticResource SmallPrimary}" HorizontalAlignment="Right" Padding="16,5"/>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- 3. VOICE-OVER -->
                    <TabItem Header="VOICE-OVER">
                        <Grid Margin="12,10,12,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding ToggleVoiceOverCommand}" Padding="18,8" Margin="0,0,12,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Content" Value="🎙  START VOICE-OVER"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVoiceOverActive}" Value="True">
                                                    <Setter Property="Content" Value="■  STOP VOICE-OVER"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Grid.Column="1" Content="🎙  HOLD PROGRAM SOUND" Command="{Binding HoldProgramSoundCommand}" Style="{StaticResource SecondaryButton}" Padding="14,8" HorizontalAlignment="Left"
                                        ToolTip="The video on air keeps talking as a voice-over while you TAKE pictures or other clips over it"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="Voice-over track (optional) — audio, or a video whose sound you want" Style="{StaticResource FieldLabel}"/>
                            <Grid Grid.Row="2" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource InkBase}" BorderBrush="{StaticResource BorderLine}" BorderThickness="1" Padding="8,4" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding VoiceOverAudioDisplay}" Foreground="{StaticResource TextHi}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <Button Grid.Column="1" Content="CHOOSE AUDIO / VIDEO…" Command="{Binding SelectVoiceOverAudioCommand}" Style="{StaticResource SmallButton}" Margin="0,0,4,0"/>
                                <Button Grid.Column="2" Content="CLEAR" Command="{Binding ClearVoiceOverAudioCommand}" Style="{StaticResource SmallButton}"/>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Narrator name (shown on the VOICE OVER tag)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding VoiceOverName, UpdateSourceTrigger=LostFocus}" Padding="6,3"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Designation" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding VoiceOverDesignation, UpdateSourceTrigger=LostFocus}" Padding="6,3"/>
                                </StackPanel>
                            </Grid>

                            <WrapPanel Grid.Row="4">
                                <CheckBox Content="Show VOICE OVER tag on screen" IsChecked="{Binding VoiceOverShowTag}" Margin="0,0,18,6"/>
                                <CheckBox Content="Loop the track" IsChecked="{Binding VoiceOverLoop}" Margin="0,0,18,6"/>
                            </WrapPanel>

                            <TextBlock Grid.Row="5" TextWrapping="Wrap" Style="{StaticResource MicroLabel}" FontSize="11" Margin="0,6,0,0"
                                       Text="HOLD PROGRAM SOUND: the video on air keeps talking while you TAKE pictures or other clips over it (their own sound stays off). A video chosen as the track plays its sound only. No track = live narrator: the video sound dips and the tag shows until STOP. Standby (F6 / Esc) always stops the voice-over."/>
                        </Grid>
                    </TabItem>

                    <!-- 4. SPEAKER WINDOWS -->
                    <TabItem Header="SPEAKERS">
                        <Grid Margin="10,8,10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Layout" Style="{StaticResource MicroLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding SpeakerLayouts}" SelectedValue="{Binding SpeakerLayout}" SelectedValuePath="Key" DisplayMemberPath="Value" Padding="6,3"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="SHOW ON AIR" Command="{Binding ShowSpeakersCommand}" Style="{StaticResource SmallPrimary}" Margin="0,0,4,0"/>
                                    <Button Content="UPDATE" Command="{Binding SaveSpeakersCommand}" Style="{StaticResource SmallButton}" Margin="0,0,4,0" ToolTip="Save names/camera changes and refresh them on air"/>
                                    <Button Content="HIDE" Command="{Binding HideSpeakersCommand}" Style="{StaticResource SmallButton}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style x:Key="BoxPanel" TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource InkBase}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderLine}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                    </Style>
                                </Grid.Resources>

                                <!-- Window 1 -->
                                <Border Grid.Column="0" Style="{StaticResource BoxPanel}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <CheckBox DockPanel.Dock="Right" Content="Show" IsChecked="{Binding Speaker1.IsEnabled}"/>
                                            <TextBlock Text="WINDOW 1 · LEFT / TOP" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextHi}"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Speaker1SourceDisplay}" Foreground="{StaticResource AccentCoral}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                        <WrapPanel Margin="0,0,0,6">
                                            <Button Content="CLIP / PICTURE…" Command="{Binding SelectSpeakerFileCommand}" CommandParameter="1" Style="{StaticResource SmallButton}" Margin="0,0,4,4"/>
                                            <Button Content="CAMERA" Command="{Binding UseSpeakerCameraCommand}" CommandParameter="1" Style="{StaticResource SmallButton}" Margin="0,0,4,4"/>
                                            <ComboBox ItemsSource="{Binding CameraChoices}" SelectedValue="{Binding Speaker1.CameraIndex}" SelectedValuePath="Key" DisplayMemberPath="Value" Width="86" Padding="4,2" Margin="0,0,4,4"/>
                                            <Button Content="CLEAR" Command="{Binding ClearSpeakerCommand}" CommandParameter="1" Style="{StaticResource SmallButton}" Margin="0,0,0,4"/>
                                        </WrapPanel>
                                        <TextBlock Text="Speaker name" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Speaker1.Name}" Padding="6,3" Margin="0,0,0,4"/>
                                        <TextBlock Text="Designation" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Speaker1.Designation}" Padding="6,3" Margin="0,0,0,6"/>
                                        <CheckBox Content="Play clip sound (ducks program)" IsChecked="{Binding Speaker1.PlayAudio}" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Window 2 -->
                                <Border Grid.Column="2" Style="{StaticResource BoxPanel}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <CheckBox DockPanel.Dock="Right" Content="Show" IsChecked="{Binding Speaker2.IsEnabled}"/>
                                            <TextBlock Text="WINDOW 2 · RIGHT / BOTTOM" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextHi}"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Speaker2SourceDisplay}" Foreground="{StaticResource AccentCoral}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                        <WrapPanel Margin="0,0,0,6">
                                            <Button Content="CLIP / PICTURE…" Command="{Binding SelectSpeakerFileCommand}" CommandParameter="2" Style="{StaticResource SmallButton}" Margin="0,0,4,4"/>
                                            <Button Content="CAMERA" Command="{Binding UseSpeakerCameraCommand}" CommandParameter="2" Style="{StaticResource SmallButton}" Margin="0,0,4,4"/>
                                            <ComboBox ItemsSource="{Binding CameraChoices}" SelectedValue="{Binding Speaker2.CameraIndex}" SelectedValuePath="Key" DisplayMemberPath="Value" Width="86" Padding="4,2" Margin="0,0,4,4"/>
                                            <Button Content="CLEAR" Command="{Binding ClearSpeakerCommand}" CommandParameter="2" Style="{StaticResource SmallButton}" Margin="0,0,0,4"/>
                                        </WrapPanel>
                                        <TextBlock Text="Speaker name" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Speaker2.Name}" Padding="6,3" Margin="0,0,0,4"/>
                                        <TextBlock Text="Designation" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Speaker2.Designation}" Padding="6,3" Margin="0,0,0,6"/>
                                        <CheckBox Content="Play clip sound (ducks program)" IsChecked="{Binding Speaker2.PlayAudio}" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- 5. INTRO & THEME -->
                    <TabItem Header="INTRO">
                        <Grid Margin="12,10,12,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="PLAY INTRO ON AIR" Command="{Binding PlayIntroCommand}" Style="{StaticResource PrimaryButton}" Padding="18,8" Margin="0,0,8,0"/>
                                <Button Content="SKIP" Command="{Binding SkipIntroCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding IntroStatusText}" Foreground="{StaticResource TextHi}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="After intro" Style="{StaticResource MicroLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding IntroPostActions}" SelectedValue="{Binding IntroPostAction}"
                                          SelectedValuePath="Key" DisplayMemberPath="Value" Width="280" Padding="6,3"/>
                            </StackPanel>
                            <Grid Grid.Row="2" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Intro video" Style="{StaticResource MicroLabel}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding IntroVideoDisplay}" Foreground="{StaticResource TextHi}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="CHOOSE…" Command="{Binding SelectIntroVideoCommand}" Style="{StaticResource SmallButton}" Margin="0,0,4,0"/>
                                <Button Grid.Column="3" Content="CLEAR" Command="{Binding ClearIntroVideoCommand}" Style="{StaticResource SmallButton}"/>
                            </Grid>
                            <Grid Grid.Row="3" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Theme music" Style="{StaticResource MicroLabel}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding IntroAudioDisplay}" Foreground="{StaticResource TextHi}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="CHOOSE…" Command="{Binding SelectIntroAudioCommand}" Style="{StaticResource SmallButton}" Margin="0,0,4,0"/>
                                <Button Grid.Column="3" Content="CLEAR" Command="{Binding ClearIntroAudioCommand}" Style="{StaticResource SmallButton}"/>
                            </Grid>
                            <TextBlock Grid.Row="4" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource MicroLabel}" FontSize="11"
                                       Text="With no video chosen, the built-in 12-second title sequence plays with its own synthesised theme. A chosen video plays instead; a chosen music file replaces the built-in theme or the video's own sound. Intro volume is in the Audio Mixer. Esc or SKIP ends it early."/>
                        </Grid>
                    </TabItem>

                    <!-- 6. TRANSITIONS -->
                    <TabItem Header="TRANSITIONS">
                        <Grid Margin="10,8,10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" TextWrapping="Wrap" Style="{StaticResource MicroLabel}" FontSize="11" Margin="0,0,0,8"
                                       Text="Each source keeps its own effect (set it under Sources, or in the TRANSITION box above TAKE). Animated effects run 500 ms, Cut is instant. TEST plays the effect on a rehearsal card — the on-air scene is never touched."/>
                            <UniformGrid Grid.Row="1" Columns="4" Rows="2">
                                <UniformGrid.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Setter Property="Margin" Value="3"/>
                                        <Setter Property="FontSize" Value="12.5"/>
                                    </Style>
                                </UniformGrid.Resources>
                                <Button Content="CUT · 0 ms" Click="OnTestTransitionClick" Tag="Cut"/>
                                <Button Content="FADE" Click="OnTestTransitionClick" Tag="Fade"/>
                                <Button Content="DISSOLVE" Click="OnTestTransitionClick" Tag="Dissolve"/>
                                <Button Content="SLIDE LEFT" Click="OnTestTransitionClick" Tag="SlideLeft"/>
                                <Button Content="SLIDE RIGHT" Click="OnTestTransitionClick" Tag="SlideRight"/>
                                <Button Content="WIPE" Click="OnTestTransitionClick" Tag="Wipe"/>
                                <Button Content="ZOOM" Click="OnTestTransitionClick" Tag="Zoom"/>
                            </UniformGrid>
                            <TextBlock Grid.Row="2" Text="{Binding TransitionPreviewStatus, StringFormat='Transition engine: {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentCoral}" Margin="0,6,0,0"/>
                        </Grid>
                    </TabItem>

                    <!-- 7. OUTPUT SETUP & KEYS -->
                    <TabItem Header="SETUP">
                        <Grid Margin="12,10,12,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PROJECTOR SETUP" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextHi}" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Foreground="{StaticResource TextMid}"
                                           Text="1. Connect the projector by HDMI.&#x0a;2. Press Win + P → Extend.&#x0a;3. Pick it in OUTPUT (top bar) and press LAUNCH PROJECTOR.&#x0a;4. The audience screen shows no controls or cursor."/>
                                <Button Content="REFRESH MONITORS" Command="{Binding RefreshDisplaysCommand}" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="KEYBOARD" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextHi}" Margin="0,0,0,6"/>
                                <TextBlock FontSize="12.5" LineHeight="20" Foreground="{StaticResource TextMid}">
                                    <Run Text="F5" FontFamily="Consolas" FontWeight="Bold" Foreground="#FF6B6B"/><Run Text="   TAKE Preview to Program"/><LineBreak/>
                                    <Run Text="F6" FontFamily="Consolas" FontWeight="Bold" Foreground="#4A93F0"/><Run Text="   Toggle standby slate"/><LineBreak/>
                                    <Run Text="F7" FontFamily="Consolas" FontWeight="Bold" Foreground="#FF6B6B"/><Run Text="   Breaking news live"/><LineBreak/>
                                    <Run Text="F8" FontFamily="Consolas" FontWeight="Bold" Foreground="#FF6B6B"/><Run Text="   Theme intro to air (emergency filler)"/><LineBreak/>
                                    <Run Text="F9" FontFamily="Consolas" FontWeight="Bold" Foreground="#4A93F0"/><Run Text="   All headlines on screen / off"/><LineBreak/>
                                    <Run Text="Shift+F7" FontFamily="Consolas" FontWeight="Bold" Foreground="#FF6B6B"/><Run Text="  Full-screen BREAKING NEWS takeover"/><LineBreak/>
                                    <Run Text="Ctrl+1…8" FontFamily="Consolas" FontWeight="Bold" Foreground="#FF7A63"/><Run Text="  Sound pads (Ctrl+0 stops)"/><LineBreak/>
                                    <Run Text="Space" FontFamily="Consolas" FontWeight="Bold"/><Run Text="  Play / pause program video"/><LineBreak/>
                                    <Run Text="Esc" FontFamily="Consolas" FontWeight="Bold"/><Run Text="   Emergency standby"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- 8. SOUND EFFECTS: eight pads, fired on air (Ctrl+1…8, Ctrl+0 stops) -->
                    <TabItem Header="SOUNDS">
                        <Grid Margin="10,8,10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="■ STOP SOUNDS  Ctrl+0" Command="{Binding StopSoundsCommand}" Style="{StaticResource SmallButton}"/>
                                <TextBlock Text="Load a sound into each pad. Click ▶ or press Ctrl+number to play it through the projector output." Style="{StaticResource MicroLabel}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SoundPads}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource InkBase}" BorderBrush="{StaticResource BorderLine}" BorderThickness="1" Padding="6,3" Margin="0,0,0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="54"/>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="▶" Command="{Binding DataContext.PlaySoundPadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="4,1" Margin="0,0,6,0" ToolTip="Play on air">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SmallPrimary}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                        <Setter Property="Content" Value="♪"/>
                                                                        <Setter Property="Background" Value="#2E7DE1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <TextBlock Grid.Column="1" Text="{Binding Hotkey}" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource AccentCoral}" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" Margin="0,0,6,0" ToolTip="Pad name (shown on its button)"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding FileLabel}" Foreground="{StaticResource TextMuted}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Slider Grid.Column="4" Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Pad volume"/>
                                                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                                                        <Button Content="LOAD…" Command="{Binding DataContext.ChooseSoundPadFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource SmallButton}" Padding="6,1" FontSize="11" Margin="0,0,3,0"/>
                                                        <Button Content="✕" Command="{Binding DataContext.ClearSoundPadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource SmallButton}" Padding="6,1" FontSize="11" ToolTip="Empty this pad"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- ======================= CONTROLS ======================= -->
            <Border Grid.Column="6" Style="{StaticResource Dock}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource DockHeader}">
                        <TextBlock Text="CONTROLS" Style="{StaticResource DockTitle}"/>
                    </Border>
                    <!-- Scrolls when its sections outgrow the dock, so no button is ever cut off -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,8,10,8">
                        <!-- Breaking news -->
                        <Border Background="#2A050B" BorderBrush="#7E1220" BorderThickness="1" Padding="8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="BREAKING NEWS" FontFamily="{StaticResource FontHead}" FontWeight="ExtraBold" FontSize="12" Foreground="#FF6B6B" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding QuickBreakingHeadline, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" Padding="5,3" Margin="0,0,0,4" TextWrapping="Wrap" MaxHeight="40" ToolTip="Breaking headline"/>
                                <TextBox Text="{Binding QuickBreakingSubtitle, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="5,3" Margin="0,0,0,6" ToolTip="Breaking detail"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Content="CUE" Command="{Binding QuickBreakingPreviewCommand}" Style="{StaticResource SmallButton}" ToolTip="Cue as a full-screen breaking slide"/>
                                    <Button Grid.Column="2" Content="LIVE  F7" Command="{Binding QuickBreakingLiveCommand}" ToolTip="Breaking headline as a lower third + red ticker (F7)" Style="{StaticResource SmallPrimary}"/>
                                </Grid>
                                <Button Command="{Binding ToggleBreakingTakeoverCommand}" Margin="0,4,0,0" ToolTip="Full-screen BREAKING NEWS, no headline (Shift+F7)">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SmallPrimary}">
                                            <Setter Property="Content" Value="TAKEOVER  Shift+F7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBreakingTakeoverLive}" Value="True">
                                                    <Setter Property="Content" Value="■ END TAKEOVER"/>
                                                    <Setter Property="Background" Value="#7E1220"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Intro -->
                        <TextBlock Text="INTRO SEQUENCE" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Content="▶ PLAY INTRO" Command="{Binding PlayIntroCommand}" Style="{StaticResource SmallPrimary}"/>
                            <Button Grid.Column="2" Content="SKIP" Command="{Binding SkipIntroCommand}" Style="{StaticResource SmallButton}"/>
                        </Grid>
                        <TextBlock Text="{Binding IntroStatusText}" FontSize="11.5" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                        <!-- Headlines segment -->
                        <TextBlock Text="HEADLINES" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="4"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Content="▶ PLAY" Command="{Binding PlayHeadlinesCommand}" Style="{StaticResource SmallPrimary}"/>
                            <Button Grid.Column="2" Content="NEXT" Command="{Binding NextHeadlineCommand}" Style="{StaticResource SmallButton}"/>
                            <Button Grid.Column="4" Content="■" Command="{Binding StopHeadlinesCommand}" Style="{StaticResource SmallButton}" ToolTip="Stop headlines"/>
                        </Grid>
                        <TextBlock Text="{Binding HeadlinesStatusText}" FontSize="11.5" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                        <!-- Quick overlay actions -->
                        <DockPanel Margin="0,0,0,2">
                            <Button DockPanel.Dock="Right" Content="■ STOP" Command="{Binding StopSoundsCommand}" Style="{StaticResource SmallButton}" Padding="6,0" FontSize="10.5" ToolTip="Stop all sounds (Ctrl+0)"/>
                            <TextBlock Text="SOUND FX  (Ctrl+1…8)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding SoundPads}" Margin="0,0,0,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.PlaySoundPadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            Margin="1" Padding="4,2" FontSize="11" ToolTip="{Binding Hotkey}">
                                        <Button.Content>
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Slot, Mode=OneWay}" Foreground="#FF7A63" FontWeight="Bold"/>
                                                <Run Text="{Binding Label, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Button.Content>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Background" Value="#1B4E96"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasSound}" Value="False">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="QUICK" Style="{StaticResource FieldLabel}"/>
                        <UniformGrid Columns="2">
                            <Button Content="SPEAKERS" Command="{Binding ShowSpeakersCommand}" Style="{StaticResource SmallButton}" Margin="0,0,2,4"/>
                            <Button Content="HIDE" Command="{Binding HideSpeakersCommand}" Style="{StaticResource SmallButton}" Margin="2,0,0,4"/>
                            <Button Content="VO START" Command="{Binding StartVoiceOverCommand}" Style="{StaticResource SmallButton}" Margin="0,0,2,4"/>
                            <Button Content="VO STOP" Command="{Binding StopVoiceOverCommand}" Style="{StaticResource SmallButton}" Margin="2,0,0,4"/>
                            <Button Content="CLEAR L3" Command="{Binding ClearLiveHeadlineCommand}" Style="{StaticResource SmallButton}" Margin="0,0,2,0"/>
                            <Button Content="TICKER ↑" Command="{Binding PublishTickerCommand}" Style="{StaticResource SmallButton}" Margin="2,0,0,0" ToolTip="Publish the ticker draft to air"/>
                        </UniformGrid>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- 4. STATUS BAR                                                  -->
        <!-- ============================================================== -->
        <Border Grid.Row="3" Background="{StaticResource InkBase}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="STATUS" Style="{StaticResource MicroLabel}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusNotification}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMid}" TextTrimming="CharacterEllipsis" MaxWidth="1050"/>
                </StackPanel>
                <TextBlock Text="F5 Take · F6 Standby · F7 Breaking · F8 Intro · F9 All headlines · Shift+F7 Takeover · Ctrl+1…8 Sounds · Space Play/Pause · Esc Emergency" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MicroLabel}" Foreground="{StaticResource TextDim}"/>
            </Grid>
        </Border>

      </Grid>
    </Viewbox>
</Window>
