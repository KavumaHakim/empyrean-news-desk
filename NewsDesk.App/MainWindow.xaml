<Window x:Class="NewsDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:NewsDesk.Core.Models;assembly=NewsDesk.Core"
        Title="NEWS DESK — Broadcast &amp; Projector Control Room"
        Height="900" Width="1440"
        MinHeight="750" MinWidth="1100"
        Background="#070D1E"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Dark Navy / Crimson Newsroom Theme Styles -->
        <SolidColorBrush x:Key="NavyDark" Color="#070D1E"/>
        <SolidColorBrush x:Key="NavyCard" Color="#0D1B2A"/>
        <SolidColorBrush x:Key="NavySurface" Color="#132238"/>
        <SolidColorBrush x:Key="NavyBorder" Color="#1E3250"/>
        <SolidColorBrush x:Key="NavyLight" Color="#415A77"/>
        <SolidColorBrush x:Key="AccentRed" Color="#D90429"/>
        <SolidColorBrush x:Key="AccentRedHover" Color="#EF233C"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#48CAE4"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#2EC4B6"/>
        <SolidColorBrush x:Key="TextLight" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8D99AE"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentRedHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource NavySurface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource NavyBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NavyLight}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionGreenButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#0F4C3A"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
            <Setter Property="Foreground" Value="#5EEAD4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15664F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource NavyDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NavyBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Dark ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource NavyDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NavyBorder}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
                        <Setter Property="Background" Value="{StaticResource NavyCard}"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{StaticResource NavySurface}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl Dark Styling -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{StaticResource NavyCard}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Margin="2,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource NavySurface}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Dual Monitors & Primary Take Live Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Quick Breaking News Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Workspace Tabs -->
            <RowDefinition Height="*"/>
            <!-- Footer Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- 1. TOP HEADER & BROADCAST ROUTING BAR                          -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="{StaticResource NavyCard}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Station Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentRed}" CornerRadius="3" Padding="8,3" Margin="0,0,10,0">
                        <TextBlock Text="NEWS" FontWeight="ExtraBold" FontSize="18" Foreground="White"/>
                    </Border>
                    <TextBlock Text="DESK" FontWeight="ExtraBold" FontSize="18" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="PRO BROADCAST CONTROLLER" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" Margin="14,2,0,0"/>
                </StackPanel>

                <!-- Projector / Display Selection -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="PROJECTOR / HDMI DISPLAY:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding ConnectedDisplays}" 
                              SelectedItem="{Binding SelectedDisplay}" 
                              DisplayMemberPath="Description" 
                              Width="280" Margin="0,0,10,0"/>
                    <Button Content="LAUNCH PROJECTOR" Command="{Binding LaunchBroadcastCommand}" Style="{StaticResource ActionGreenButton}" Margin="0,0,6,0"/>
                    <Button Content="CLOSE" Command="{Binding CloseBroadcastCommand}" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>

                <!-- Live Indicators & Standby Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Status Badge -->
                    <Border CornerRadius="4" Padding="12,5" Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#332200"/>
                                <Setter Property="BorderBrush" Value="#FFAA00"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveOnAir}" Value="True">
                                        <Setter Property="Background" Value="#5C000B"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FFAA00"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiveOnAir}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentRed}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontWeight="Bold" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="STANDBY / READY"/>
                                        <Setter Property="Foreground" Value="#FFAA00"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiveOnAir}" Value="True">
                                                <Setter Property="Text" Value="ON AIR / BROADCASTING"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Standby Toggle -->
                    <Button Content="STANDBY SLATE (F6)" Command="{Binding ToggleStandbyCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                    <Button Content="LIVE BADGE" Command="{Binding ToggleLiveIndicatorCommand}" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- 2. DUAL MONITORS: PROGRAM (ON AIR) & PREVIEW (NEXT UP)         -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PROGRAM MONITOR (ON AIR - PROJECTOR OUTPUT) -->
            <Border Grid.Column="0" Background="{StaticResource NavyCard}" BorderBrush="{StaticResource AccentRed}" BorderThickness="2" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource AccentRed}" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="PROGRAM" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            </Border>
                            <TextBlock Text="ON AIR (PROJECTOR)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentRed}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ActiveTransition, StringFormat='TRANSITION: {0}'}" 
                                   HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentCyan}"/>
                    </Grid>

                    <!-- Program Media Info -->
                    <Border Grid.Row="1" Background="{StaticResource NavyDark}" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding OnAirMedia.Title, FallbackValue='[STANDBY - NO ACTIVE STORY]'}" 
                                       FontWeight="Bold" FontSize="16" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding OnAirMedia.Category, FallbackValue='System'}" 
                                           FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentCyan}" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding PlaybackTimeText}" FontWeight="Bold" FontSize="12" Foreground="#E2E8F0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Transport Bar -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Seek Slider -->
                        <Slider x:Name="TimelineSlider" Grid.Column="0" Minimum="0" 
                                Maximum="{Binding PlaybackDuration}" 
                                Value="{Binding PlaybackCurrentTime, Mode=TwoWay}"
                                VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <!-- Transport Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="▶ PLAY" Command="{Binding PlayCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                            <Button Content="⏸ PAUSE" Command="{Binding PauseCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                            <Button Content="⏹ STOP" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                            <Button Content="↺ REPLAY" Command="{Binding ReplayCommand}" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Live Graphics Summary -->
                    <Border Grid.Row="3" Background="{StaticResource NavySurface}" CornerRadius="3" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LIVE LOWER THIRD: " FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding LiveGraphic.Title, FallbackValue='[None active]'}" 
                                       FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource TextLight}" TextTrimming="CharacterEllipsis"/>
                            <Button Content="CLEAR GRAPHIC" Command="{Binding ClearLiveHeadlineCommand}" Style="{StaticResource SecondaryButton}" 
                                    Padding="6,1" FontSize="10" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- PREVIEW MONITOR (NEXT UP - OPERATOR CUE) -->
            <Border Grid.Column="2" Background="{StaticResource NavyCard}" BorderBrush="{StaticResource AccentCyan}" BorderThickness="2" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource AccentCyan}" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="PREVIEW" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                            </Border>
                            <TextBlock Text="NEXT UP (PRIVATE CUE)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="500ms Animated Duration" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </Grid>

                    <!-- Preview Media Info -->
                    <Border Grid.Row="1" Background="{StaticResource NavyDark}" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding PreviewMedia.Title, FallbackValue='[Select a story below to cue into preview]'}" 
                                       FontWeight="Bold" FontSize="16" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding PreviewMedia.Category, FallbackValue='Ready'}" 
                                           FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentCyan}" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding PreviewMedia.FormattedDuration, FallbackValue='00:00'}" 
                                           FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TAKE LIVE PRIMARY ACTION BAR -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Big Red TAKE LIVE Button -->
                        <Button Grid.Column="0" Content="★ TAKE LIVE (F5)" 
                                Command="{Binding TakeLiveCommand}" 
                                Style="{StaticResource PrimaryButton}" 
                                FontSize="16" Padding="20,10" Margin="0,0,10,0"/>

                        <!-- Transition Selector for Preview -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="TRANSITION: " FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding AvailableTransitions}" 
                                      SelectedItem="{Binding PreviewTransition, Mode=TwoWay}"
                                      Width="120"/>
                        </StackPanel>

                        <!-- Preview Graphic button -->
                        <Button Grid.Column="2" Content="PREVIEW SLIDE" Command="{Binding PreviewHeadlineCommand}" Style="{StaticResource SecondaryButton}"/>
                    </Grid>

                    <!-- Prepared Graphic Summary -->
                    <Border Grid.Row="3" Background="{StaticResource NavySurface}" CornerRadius="3" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PREPARED GRAPHIC: " FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding EditingHeadline.Title, FallbackValue='[None prepared]'}" 
                                       FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource TextLight}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- 3. QUICK BREAKING NEWS BAR                                     -->
        <!-- ============================================================== -->
        <Border Grid.Row="2" Background="#4A050B" BorderBrush="{StaticResource AccentRed}" BorderThickness="0,1,0,1" Padding="16,8" Margin="0,4,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource AccentRed}" CornerRadius="3" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="BREAKING NEWS" FontWeight="ExtraBold" FontSize="12" Foreground="White"/>
                </Border>

                <!-- Quick Headline -->
                <TextBox Grid.Column="1" Text="{Binding QuickBreakingHeadline, UpdateSourceTrigger=PropertyChanged}" 
                         FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>

                <!-- Quick Subtitle -->
                <TextBox Grid.Column="2" Text="{Binding QuickBreakingSubtitle, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,12,0" VerticalAlignment="Center"/>

                <!-- Actions -->
                <Button Grid.Column="3" Content="PREVIEW BREAKING" Command="{Binding QuickBreakingPreviewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                <Button Grid.Column="4" Content="TAKE BREAKING LIVE (F7)" Command="{Binding QuickBreakingLiveCommand}" Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- 4. WORKSPACE TABS                                              -->
        <!-- ============================================================== -->
        <TabControl Grid.Row="3" Background="{StaticResource NavySurface}" BorderBrush="{StaticResource NavyBorder}" Margin="16,0,16,8">
            
            <!-- TAB 1: MEDIA LIBRARY -->
            <TabItem Header="📁 MEDIA LIBRARY">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0"/>

                        <TextBlock Grid.Column="2" Text="Category:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding CategoryFilter}" Margin="0,0,16,0"/>

                        <Button Grid.Column="5" Content="➕ IMPORT VIDEO FILES..." Command="{Binding ImportVideoCommand}" Style="{StaticResource PrimaryButton}"/>
                    </Grid>

                    <!-- Media DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredMediaLibrary}" 
                              SelectedItem="{Binding SelectedMedia}"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              Background="{StaticResource NavyDark}" 
                              RowBackground="{StaticResource NavyCard}"
                              AlternatingRowBackground="{StaticResource NavyDark}"
                              Foreground="{StaticResource TextLight}"
                              BorderBrush="{StaticResource NavyBorder}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource NavyBorder}"
                              HeadersVisibility="Column"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
                            <DataGridTextColumn Header="Assigned Transition" Binding="{Binding AssignedTransition}" Width="150"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding IsAvailable}" Width="100"/>
                            <DataGridTextColumn Header="File Path" Binding="{Binding FilePath}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Selected Media Action Bar -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Change transition for selected video -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Assigned Transition: " FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="ComboSelectedTransition" 
                                      ItemsSource="{Binding AvailableTransitions}" 
                                      SelectedItem="{Binding SelectedMedia.AssignedTransition, Mode=TwoWay}"
                                      SelectionChanged="OnTransitionSelectionChanged"
                                      Width="140"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="LOAD TO PREVIEW" Command="{Binding SelectForPreviewCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <Button Content="➕ ADD TO RUNDOWN" Command="{Binding AddToRundownCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        </StackPanel>

                        <Button Grid.Column="3" Content="REMOVE ENTRY" Command="{Binding DeleteMediaCommand}" Style="{StaticResource SecondaryButton}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: NEWS RUNDOWN / PLAYLIST -->
            <TabItem Header="📋 NEWS RUNDOWN">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Ordered story rundown for current broadcast. Drag or use controls to sequence stories." 
                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding RundownItems}" 
                              SelectedItem="{Binding SelectedRundownItem}"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              Background="{StaticResource NavyDark}" 
                              RowBackground="{StaticResource NavyCard}"
                              AlternatingRowBackground="{StaticResource NavyDark}"
                              Foreground="{StaticResource TextLight}"
                              BorderBrush="{StaticResource NavyBorder}"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding OrderIndex}" Width="50"/>
                            <DataGridTextColumn Header="Story Title" Binding="{Binding MediaItem.Title}" Width="3*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding MediaItem.Category}" Width="150"/>
                            <DataGridTextColumn Header="Assigned Transition" Binding="{Binding MediaItem.AssignedTransition}" Width="150"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding MediaItem.FormattedDuration}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="▲ MOVE UP" Command="{Binding MoveRundownUpCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                            <Button Content="▼ MOVE DOWN" Command="{Binding MoveRundownDownCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/>
                            <Button Content="LOAD TO PREVIEW" Command="{Binding SelectForPreviewCommand}" CommandParameter="{Binding SelectedRundownItem.MediaItem}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                            <Button Content="★ TAKE LIVE FROM RUNDOWN" Command="{Binding TakeLiveRundownCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/>
                            <Button Content="REMOVE FROM RUNDOWN" Command="{Binding RemoveFromRundownCommand}" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 3: HEADLINES & GRAPHICS STUDIO -->
            <TabItem Header="🎨 HEADLINES &amp; GRAPHICS STUDIO">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Graphic Editor Form -->
                    <Border Grid.Column="0" Background="{StaticResource NavyCard}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" CornerRadius="4" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="GRAPHIC &amp; LOWER THIRD DESIGNER" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,14"/>

                                <TextBlock Text="Headline Title:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditingHeadline.Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                <TextBlock Text="Supporting Summary:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditingHeadline.Subtitle, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Category:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EditingHeadline.Category, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Location Tag:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EditingHeadline.Location, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Reporter Name:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EditingHeadline.ReporterName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Reporter Title:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EditingHeadline.ReporterTitle, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="Mark as BREAKING NEWS" IsChecked="{Binding EditingHeadline.IsBreaking}" Foreground="White" Margin="0,0,0,16"/>

                                <!-- Action Buttons -->
                                <WrapPanel Margin="0,0,0,6">
                                    <Button Content="💾 SAVE DRAFT" Command="{Binding SaveHeadlineDraftCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"/>
                                    <Button Content="👁 PREVIEW SLIDE" Command="{Binding PreviewHeadlineCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"/>
                                    <Button Content="★ TAKE LIVE" Command="{Binding TakeLiveHeadlineCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6"/>
                                    <Button Content="UPDATE LIVE" Command="{Binding UpdateLiveHeadlineCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"/>
                                    <Button Content="CLEAR" Command="{Binding ClearLiveHeadlineCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Saved Drafts List -->
                    <Border Grid.Column="2" Background="{StaticResource NavyCard}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" CornerRadius="4" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="SAVED GRAPHIC DRAFTS (Click to load)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextLight}" Margin="0,0,0,10"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding HeadlineDrafts}" 
                                      AutoGenerateColumns="False" 
                                      IsReadOnly="True"
                                      Background="{StaticResource NavyDark}" 
                                      RowBackground="{StaticResource NavyCard}"
                                      AlternatingRowBackground="{StaticResource NavyDark}"
                                      Foreground="{StaticResource TextLight}"
                                      BorderBrush="{StaticResource NavyBorder}"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                                    <DataGridTextColumn Header="Reporter" Binding="{Binding ReporterName}" Width="120"/>
                                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="110"/>
                                    <DataGridTemplateColumn Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="LOAD" Command="{Binding DataContext.LoadHeadlineDraftCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="8,2" Margin="0,0,4,0"/>
                                                    <Button Content="DEL" Command="{Binding DataContext.DeleteHeadlineDraftCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="8,2"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: NEWS TICKER STUDIO -->
            <TabItem Header="📰 NEWS TICKER STUDIO">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Add Ticker Item Form -->
                    <Border Grid.Row="0" Background="{StaticResource NavyCard}" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Category:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Text="{Binding NewTickerItemCategory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="2" Text="Headline Text:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="3" Text="{Binding NewTickerItemText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>

                            <Button Grid.Column="4" Content="➕ ADD ITEM" Command="{Binding AddTickerItemCommand}" Style="{StaticResource PrimaryButton}"/>
                        </Grid>
                    </Border>

                    <!-- Ticker Items DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TickerDraftItems}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="False"
                              Background="{StaticResource NavyDark}" 
                              RowBackground="{StaticResource NavyCard}"
                              AlternatingRowBackground="{StaticResource NavyDark}"
                              Foreground="{StaticResource TextLight}"
                              BorderBrush="{StaticResource NavyBorder}"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
                            <DataGridTextColumn Header="Ticker Headline Text" Binding="{Binding Text}" Width="4*"/>
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="DELETE" Command="{Binding DataContext.DeleteTickerItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="8,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Ticker Styling & Publish Bar -->
                    <Border Grid.Row="2" Background="{StaticResource NavyCard}" CornerRadius="4" Padding="12" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Content="Urgent Breaking Style (Red Ribbon)" IsChecked="{Binding DraftTickerConfig.IsBreakingStyle}" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Button Grid.Column="1" Content="⏸ PAUSE / RESUME SCROLL" Command="{Binding ToggleTickerPauseCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/>

                            <!-- Prominent Publish Ticker Button -->
                            <Button Grid.Column="4" Content="📢 PUBLISH TICKER TO AIR" Command="{Binding PublishTickerCommand}" Style="{StaticResource PrimaryButton}" FontSize="14" Padding="20,8"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 5: TRANSITIONS MANAGER & TEST -->
            <TabItem Header="⚡ TRANSITIONS MANAGER">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="BROADCAST TRANSITION ENGINE" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AccentCyan}"/>
                        <TextBlock Text="All animated transitions run at exactly 500 milliseconds. Cut transitions run instantaneously (0 milliseconds)." 
                                   Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Transition Cards Grid -->
                    <UniformGrid Grid.Row="1" Columns="4" Rows="2">
                        <!-- Cut -->
                        <Border Background="{StaticResource NavyCard}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" CornerRadius="6" Margin="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="1. CUT" FontWeight="ExtraBold" FontSize="16" Foreground="{StaticResource AccentRed}"/>
                                <TextBlock Text="Duration: 0 ms" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,8"/>
                                <TextBlock Text="Immediately switches between outgoing and incoming scenes without intermediate frames." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextLight}" Margin="0,0,0,12"/>
                                <Button Content="TEST CUT" Click="OnTestTransitionClick" Tag="Cut" Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </Border>

                        <!-- Fade -->
                        <Border Background="{StaticResource NavyCard}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" CornerRadius="6" Margin="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="2. FADE" FontWeight="ExtraBold" FontSize="16" Foreground="{StaticResource AccentCyan}"/>
                                <TextBlock Text="Duration: 500 ms" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,8"/>
                                <TextBlock Text="Fades outgoing scene to black in 250ms and incoming scene in from black in 250ms." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextLight}" Margin="0,0,0,12"/>
                                <Button Content="TEST FADE" Click="OnTestTransitionClick" Tag="Fade" Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </Border>

                        <!-- Dissolve -->
                        <Border Background="{StaticResource NavyCard}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" CornerRadius="6" Margin="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="3. DISSOLVE" FontWeight="ExtraBold" FontSize="16" Foreground="{StaticResource AccentCyan}"/>
                                <TextBlock Text="Duration: 500 ms" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,8"/>
                                <TextBlock Text="Direct cross-blend between scenes without an intermediate black screen." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextLight}" Margin="0,0,0,12"/>
                                <Button Content="TEST DISSOLVE" Click="OnTestTransitionClick" Tag="Dissolve" Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </Border>

                        <!-- Slide Left -->
                        <Border Background="{StaticResource NavyCard}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" CornerRadius="6" Margin="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="4. SLIDE LEFT" FontWeight="ExtraBold" FontSize="16" Foreground="{StaticResource AccentCyan}"/>
                                <TextBlock Text="Duration: 500 ms" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,8"/>
                                <TextBlock Text="Animates incoming scene from the right while moving outgoing scene to the left." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextLight}" Margin="0,0,0,12"/>
                                <Button Content="TEST SLIDE LEFT" Click="OnTestTransitionClick" Tag="SlideLeft" Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </Border>

                        <!-- Slide Right -->
                        <Border Background="{StaticResource NavyCard}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" CornerRadius="6" Margin="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="5. SLIDE RIGHT" FontWeight="ExtraBold" FontSize="16" Foreground="{StaticResource AccentCyan}"/>
                                <TextBlock Text="Duration: 500 ms" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,8"/>
                                <TextBlock Text="Animates incoming scene from the left while moving outgoing scene to the right." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextLight}" Margin="0,0,0,12"/>
                                <Button Content="TEST SLIDE RIGHT" Click="OnTestTransitionClick" Tag="SlideRight" Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </Border>

                        <!-- Wipe -->
                        <Border Background="{StaticResource NavyCard}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" CornerRadius="6" Margin="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="6. WIPE" FontWeight="ExtraBold" FontSize="16" Foreground="{StaticResource AccentCyan}"/>
                                <TextBlock Text="Duration: 500 ms" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,8"/>
                                <TextBlock Text="Progressively reveals incoming scene across the screen with hardware clipping." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextLight}" Margin="0,0,0,12"/>
                                <Button Content="TEST WIPE" Click="OnTestTransitionClick" Tag="Wipe" Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </Border>

                        <!-- Zoom -->
                        <Border Background="{StaticResource NavyCard}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" CornerRadius="6" Margin="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="7. ZOOM" FontWeight="ExtraBold" FontSize="16" Foreground="{StaticResource AccentCyan}"/>
                                <TextBlock Text="Duration: 500 ms" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,8"/>
                                <TextBlock Text="Scale zoom animation cleanly transitioning incoming scene forward." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextLight}" Margin="0,0,0,12"/>
                                <Button Content="TEST ZOOM" Click="OnTestTransitionClick" Tag="Zoom" Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="2" Background="{StaticResource NavyCard}" CornerRadius="4" Padding="12" Margin="0,10,0,0">
                        <TextBlock Text="{Binding TransitionPreviewStatus, StringFormat='Transition Engine Status: {0}'}" 
                                   FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 6: DISPLAYS & KEYBOARD SHORTCUTS -->
            <TabItem Header="⚙ DISPLAYS &amp; SHORTCUTS">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource NavyCard}" CornerRadius="6" Padding="16">
                        <StackPanel>
                            <TextBlock Text="HDMI PROJECTOR &amp; EXTENDED DISPLAY" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,12"/>
                            <TextBlock Text="Windows Extended Display Configuration:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="1. Connect HDMI cable between laptop and projector.&#x0a;2. In Windows Display Settings, select 'Extend these displays' (Win + P).&#x0a;3. Select the projector from the dropdown above and click 'LAUNCH PROJECTOR'.&#x0a;4. The broadcast window opens borderless fullscreen on the projector with all controls hidden." 
                                       TextWrapping="Wrap" Foreground="{StaticResource TextLight}" LineHeight="20" Margin="0,0,0,16"/>

                            <Button Content="REFRESH DETECTED MONITORS" Command="{Binding RefreshDisplaysCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource NavyCard}" CornerRadius="6" Padding="16">
                        <StackPanel>
                            <TextBlock Text="OPERATOR KEYBOARD SHORTCUTS" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="F5" FontWeight="Bold" Foreground="{StaticResource AccentRed}"/>
                                <TextBlock Grid.Column="1" Text="TAKE LIVE (Switches prepared preview content to on-air)"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="F6" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                                <TextBlock Grid.Column="1" Text="TOGGLE STANDBY (Switches to broadcast station testcard)"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="F7" FontWeight="Bold" Foreground="{StaticResource AccentRed}"/>
                                <TextBlock Grid.Column="1" Text="TAKE BREAKING NEWS LIVE"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Space" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Grid.Column="1" Text="PLAY / PAUSE current on-air video"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Esc" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Grid.Column="1" Text="EMERGENCY STANDBY"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ============================================================== -->
        <!-- 5. BOTTOM SYSTEM STATUS NOTIFICATION BAR                       -->
        <!-- ============================================================== -->
        <Border Grid.Row="4" Background="{StaticResource NavyDark}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="STATUS: " FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding StatusNotification}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextLight}"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="NEWS DESK V1.0 • WINDOWS HDMI BROADCAST ENGINE" FontWeight="Bold" FontSize="10" Foreground="{StaticResource NavyLight}"/>
            </Grid>
        </Border>

    </Grid>
</Window>
